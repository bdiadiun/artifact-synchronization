{
  "name": "artifact-synchronization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Viewer + Scoring Form micro-frontend: host-app and an OHIF Viewer fork talking over window.postMessage",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "host-app",
    "packages/*"
  ],
  "scripts": {
    "graph:build": "node scripts/graph.mjs build",
    "check:graph": "node scripts/graph.mjs check",
    "docs:build": "node scripts/build-docs.mjs",
    "test": "npm run test --workspace host-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "viewer:setup": "node scripts/viewer.mjs setup",
    "viewer:dev": "node scripts/viewer.mjs dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.7",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
