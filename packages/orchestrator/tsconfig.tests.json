{
  // Type-checking project for the package's tests: the same compiler options as the published
  // build, plus the __tests__ folder the build excludes, and no emit so nothing reaches dist.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
