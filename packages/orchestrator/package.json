{
  "name": "@bdiadiun/scoring-orchestrator",
  "version": "0.0.7",
  "description": "framework-free postMessage orchestrator that drives an OHIF viewer bridge from any host application",
  "license": "MIT",
  "repository": {
    "type": "git",
