{
  "name": "@bdiadiun/ohif-extension-loader",
  "version": "0.1.2",
  "description": "OHIF extension that loads our extensions into the viewer, so the fork carries one entry that never changes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdiadiun/artifact-synchronization.git",
    "directory": "packages/ohif-extension-loader"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@bdiadiun/ohif-extension-scoring-viewer": "0.1.2"
  }
}
