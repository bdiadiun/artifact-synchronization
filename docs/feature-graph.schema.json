{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-graph.schema.json",
  "title": "Feature graph",
  "description": "Source of truth for docs/FEATURE-GRAPH.md; `imports` is generated by `npm run graph:build`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "slices", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "slices": {
      "type": "array",
      "items": { "$ref": "#/$defs/slice" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "branch"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "pr": { "type": "integer", "minimum": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "canon",
        "dependsOn",
        "slice",
        "status",
        "verify",
        "files",
        "imports"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F-\\d{2,}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "canon": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[CQSDXPA]-\\d+(\\.\\d+)*$" }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^F-\\d{2,}$" }
        },
        "slice": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "approved", "in-progress", "review", "done"] },
        "verify": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "imports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["internal", "external"],
            "properties": {
              "internal": { "type": "array", "items": { "type": "string" } },
              "external": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
